{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "sbd/termine",
	"version": "0.1.0",
	"title": "Nächste Termine",
	"category": "widgets",
	"icon": "calendar-alt",
	"description": "Zeigt die nächsten Termine als Kacheln. Vergangene Termine verschwinden von selbst.",
	"keywords": [ "termine", "kalender", "veranstaltung", "dogodki" ],
	"textdomain": "schule-core",
	"attributes": {
		"anzahl": { "type": "number", "default": 3 },
		"leertext": { "type": "string", "default": "" }
	},
	"supports": {
		"html": false,
		"align": [ "wide", "full" ],
		"spacing": { "margin": true, "padding": true }
	},
	"editorScript": "file:./editor.js",
	"style": "file:./style.css"
}
